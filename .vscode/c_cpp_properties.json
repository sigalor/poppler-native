{
  "configurations": [
    {
      "name": "poppler-native",
      "includePath": [
        "${workspaceFolder}/native/binding",
        "${workspaceFolder}/native/poppler",
        "${workspaceFolder}/native/poppler/poppler",
        "${workspaceFolder}/native/deps/config/freetype",
        "${workspaceFolder}/native/deps/freetype/include",
        "${workspaceFolder}/native/deps/config/libpng",
        "${workspaceFolder}/native/deps/libpng",
        "${workspaceFolder}/native/deps/zlib",
        "${workspaceFolder}/node_modules/node-addon-api",
        "${env:HOME}/.cache/node-gyp/**"
      ],
      "defines": ["NAPI_CPP_EXCEPTIONS", "Z_PREFIX", "NDEBUG"],
      "cStandard": "c17",
      "cppStandard": "c++23"
    }
  ],
  "version": 4
}
